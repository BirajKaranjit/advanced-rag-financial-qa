# ---------------------------------------------------------------------------
# Only two keys are needed to run this project end to end:
#   1. HUGGINGFACE_HUB_TOKEN -- authenticates downloads of the local
#      embedding/reranker models. Both models are public, so this is
#      optional in principle, but anonymous Hugging Face Hub downloads are
#      rate-limited and this avoids first-run failures in Docker/CI.
#   2. One LLM key: GROQ_API_KEY (default provider) or GEMINI_API_KEY.
#      Set GENERATION_PROVIDER to match whichever one you provide.
# ---------------------------------------------------------------------------

HUGGINGFACE_HUB_TOKEN=

# "groq" or "gemini" -- selects the primary generation provider.
GENERATION_PROVIDER=groq

# Required if GENERATION_PROVIDER=groq (free tier: https://console.groq.com)
GROQ_API_KEY=
# Optional but recommended: set to a model your key can access.
GROQ_MODEL=llama3-70b-8192

# Required if GENERATION_PROVIDER=gemini (free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional but recommended: set to a model your key can access.
GEMINI_MODEL=gemini-3.6-flash

# Optional: Hugging Face Inference token, used only as a last-resort
# fallback if the primary provider call fails. Leave blank to disable.
HF_INFERENCE_TOKEN=
HF_FALLBACK_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# Optional: override if tesseract is not on PATH (OCR fallback for
# scanned pages). Not needed in the Docker image -- tesseract-ocr is
# installed there already.
# TESSERACT_CMD=/usr/bin/tesseract
